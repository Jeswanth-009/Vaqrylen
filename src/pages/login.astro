---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ChatFAB from '../components/ChatFAB.astro';
---

<Layout title="Login — Vaqrylen">
  <main>
    <section class="section-community" data-od-id="login-section">
      <div class="container">
        <div class="section-title">
          <h2>Log In</h2>
        </div>
        <div class="login-form">
          <form action="#" method="POST" data-netlify="true">
            <div class="form-group">
              <label for="login-email">Email *</label>
              <input type="email" id="login-email" name="email" placeholder="your@email.com" required />
            </div>
            <div class="form-group">
              <label for="login-password">Password *</label>
              <input type="password" id="login-password" name="password" placeholder="Enter your password" required />
            </div>
            <button type="submit" class="btn-subscribe">Log In</button>
          </form>
          <p class="login-alt">Don't have an account? <a href="#">Sign up</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ChatFAB />
</Layout>