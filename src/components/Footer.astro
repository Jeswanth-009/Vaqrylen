<footer class="site-footer" data-od-id="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-form">
        <h3>Join Our Mailing List</h3>
        <form class="form-group" action="#" method="POST" data-netlify="true">
          <label for="footer-email">Email *</label>
          <input type="email" id="footer-email" name="email" placeholder="your@email.com" required />
        </form>
        <div class="checkbox-row">
          <input type="checkbox" id="footer-newsletter" name="newsletter" required />
          <label for="footer-newsletter">Yes, subscribe me to your newsletter. *</label>
        </div>
        <button type="submit" class="btn-subscribe">Subscribe Now</button>
      </div>
      <div class="footer-info">
        <p>500 Terry Francine Street, San Francisco, CA 94158</p>
        <div class="footer-divider"></div>
        <p>info@mysite.com</p>
        <p>Tel: 123 456 7890</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2035 by Vaqrylen. Powered and secured by Vaqrylen Builder | San Diego, CA</p>
    </div>
  </div>
</footer>