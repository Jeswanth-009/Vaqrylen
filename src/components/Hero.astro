---
interface Props {
  videoSrc?: string;
  videoPoster?: string;
}

const { videoSrc = "/hero-video.mp4", videoPoster = "/hero-poster.jpg" } = Astro.props;
---
<header class="site-header" data-od-id="site-header">
  <nav class="header-nav" aria-label="Main navigation">
<a href="/login">LOG IN</a>
<a href="/cart">CART (0)</a>
    <div class="header-social">
      <a href="#" class="icon-btn" aria-label="Instagram">
        <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="18" cy="6" r="1.5" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="#" class="icon-btn" aria-label="Twitter">
        <svg viewBox="0 0 24 24"><path d="M4 4l6.5 8L4 20h2l5.5-6.5L15.5 20H20l-7-8.5L18.5 4h-2l-5 6L7 4H4z"/></svg>
      </a>
      <a href="#" class="icon-btn" aria-label="Linkedin">
        <svg viewBox="0 0 24 24"><path d="M12 2l1.5 4.5L18 6l-3.5 3.5.5 4.5L12 11l-4 3 .5-4.5L6 6l4.5-.5z"/><path d="M12 18l-3 2 .5-3.5L6 14l3.5-.5L12 10l3.5 3.5L18 14l-3.5 2.5z" fill="currentColor" stroke="none" opacity="0.3"/></svg>
      </a>
    </div>
    <div class="header-separator"></div>
  </nav>
</header>

<section class="hero" data-od-id="hero-section">
  <div class="hero-video" data-od-id="hero-video">
    <video
      src={videoSrc}
      poster={videoPoster}
      loop
      muted
      playsinline
      autoplay
      preload="auto"
      aria-label="Farm to table video"
    ></video>
    <div class="video-overlay">
      <span>Farm to Table</span>
    </div>
  </div>
  <div class="hero-story" data-od-id="hero-story">
    <div class="logo">
      <h1>Vaqrylen</h1>
      <div class="hero-badge">
        <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="13" fill="none" stroke="var(--muted)" stroke-width="1.5"/><path d="M8 10 L10 18 L8 15 L6 18Z" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linejoin="round"/><path d="M10 8 L12 18 L10 14 L8 18Z" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linejoin="round"/><path d="M12 10 L14 18 L12 14 L10 18Z" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linejoin="round"/><path d="M20 8 L18 24 L22 24 L20 8Z" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linejoin="round"/><path d="M18 8 L17 5 M20 8 L21 5 M22 8 L23 5" fill="none" stroke="var(--muted)" stroke-width="1" stroke-linecap="round"/><circle cx="16" cy="16" r="1.5" fill="var(--muted)" stroke="none"/></svg>
      </div>
      <p class="tagline">A FARM-TO-TABLE EXPERIENCE</p>
    </div>
    <div class="description">
      <p>From our soil to your table — Vaqrylen brings the freshest seasonal produce directly from our fields to your home. Every item is harvested at peak ripeness and delivered with care.</p>
      <p>We cultivate heritage varieties using sustainable practices, honoring the land and the hands that tend it. Taste the difference that honest farming makes.</p>
      <p>Our farm spans fifty acres of protected agricultural land just outside San Diego, where Mediterranean climate and rich alluvial soil create ideal growing conditions. We rotate crops seasonally, allowing the earth to regenerate naturally without synthetic inputs.</p>
      <p>Every Tuesday and Friday, our harvest teams move through the rows at dawn, selecting only produce that meets our exacting standards. By noon, baskets are packed and en route to homes, restaurants, and our weekend farm stand.</p>
      <p>We believe transparency builds trust. Visit us any Saturday to walk the fields, meet the growers, and taste the difference that three generations of stewardship brings to every bite.</p>
    </div>
  </div>
</section>