---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script src="/scripts/gsap.min.js" is:inline></script>
  <script src="/scripts/ScrollTrigger.min.js" is:inline></script>
  <script is:inline src="/scripts/main.js"></script>
</body>
</html>